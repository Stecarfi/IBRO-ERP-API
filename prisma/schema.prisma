datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Roles
model Role {
  id                 String   @id
  name               String
  modules            String[] @default([]) // Módulos habilitados heredados
  canAssignSales     Boolean  @default(false)
  clientLevel        Int      @default(3)
  canManageEvals     Boolean  @default(false)
  canCreateMeetings  Boolean  @default(false)
  viewTechPrice      Boolean  @default(false)
  viewWholesalePrice Boolean  @default(false)
  viewCostPrice      Boolean  @default(false)
  permissions        Json? // JSON con la estructura de permisos granulares por módulo

  users User[]
}

// 2. Usuarios
model User {
  id            String  @id
  nombre        String
  apellido      String
  cedula        String
  tipoDoc       String? @default("CC")
  correo        String
  cargo         String
  telefono      String?
  observaciones String?
  user          String  @unique
  pass          String
  roleId        String
  role          Role    @relation(fields: [roleId], references: [id])

  meta_u             Float     @default(0)
  ejec_u             Float     @default(0)
  meta_p             Float     @default(0)
  ejec_p             Float     @default(0)
  soundsEnabled      Boolean?  @default(true)
  cumpleanos         DateTime?
  habeasDataAccepted Boolean?  @default(false)
  refreshToken       String?

  // Anti-Brute Force
  failedLoginAttempts Int     @default(0)
  isLocked            Boolean @default(false)

  // Auditoría de Sesión
  lastLogin DateTime?
  isOnline  Boolean   @default(false)

  // Archivos multimedia
  foto  String?
  firma String?

  // Módulo de Ubicación
  lat                Float?
  lng                Float?
  lastLocationUpdate Float?

  // Datos Adicionales
  codigoAsesor String?

  // Roles Operativos y de Control en Campo
  esComercialCampo   Boolean   @default(false)
  esDelegadoGerencia Boolean   @default(false)

  // Relaciones Inversas
  ventas                Venta[]
  pqrs                  PQR[]                  @relation("PQRUsuario")
  servicios             Servicio[]             @relation("ServicioTecnico")
  solicitudes           Solicitud[]            @relation("SolicitudAsesor")
  procesosAsesor        ProcesoDisciplinario[] @relation("ProcesoAsesor")
  procesosJefe          ProcesoDisciplinario[] @relation("ProcesoJefe")
  evaluacionesHechas    Evaluacion[]           @relation("EvaluacionEvaluador")
  evaluacionesRecibidas Evaluacion[]           @relation("EvaluacionEvaluado")
  cotizaciones          Cotizacion[]           @relation("CotizacionVendedor")
  chatsSent             Chat[]                 @relation("ChatSender")
  chatsReceived         Chat[]                 @relation("ChatReceiver")
  chatGroupsCreated     ChatGroup[]            @relation("GroupCreator")
  auditorias            Auditoria[]
  notificaciones        Notificacion[]
  comisionistas         Comisionista[]
  pendingResets         PendingReset[]
  capacitacionesCreadas Capacitacion[]         @relation("CapacitacionCreador")

  // Operaciones en Campo
  jornadas                   JornadaLaboral[]
  visitasCampo               VisitaCampo[]
  actividadesCampo           ActividadCampo[]           @relation("ActividadUsuario")
  actividadesAsignadas       ActividadCampo[]           @relation("ActividadAsignadaPor")
  evidenciasCampo            EvidenciaCampo[]           @relation("EvidenciaUsuario")
  seguimientosCampo          SeguimientoCampo[]         @relation("SeguimientoUsuario")
  asignacionesZona           AsignacionZona[]
  metasCampo                 MetaComercialCampo[]
  prospectosCampo            ProspectoCampo[]           @relation("ProspectoVendedor")
  ordenesServicioCampo       OrdenServicioCampo[]
  evaluacionesCampoHechas    EvaluacionComercialCampo[] @relation("EvaluacionesCampoEvaluador")
  evaluacionesCampoRecibidas EvaluacionComercialCampo[] @relation("EvaluacionesCampoEvaluado")
  novedadesDelegadoCreadas   NovedadDelegadoCampo[]     @relation("NovedadDelegadoCreador")
  novedadesDelegadoRecibidas NovedadDelegadoCampo[]     @relation("NovedadDelegadoComercial")
  clientesExternos           ClienteExternoCampo[]      @relation("ClienteExternoComercial")
  cotizacionesExternas       CotizacionExternaCampo[]   @relation("CotizacionExternaComercial")
  ventasExternas             VentaExternaCampo[]        @relation("VentaExternaComercial")
}

// 3. Clientes
model Cliente {
  id                 String  @id
  doc_tipo           String
  doc                String  @unique
  nom                String
  tipo_cliente       String
  tel                String
  correo             String
  direccion          String?
  owner              String?
  lockedBy           String?
  habeasDataAccepted Boolean @default(false)

  // Campos del formato vinculación Clientes
  numVinculacion           String?
  fechaVinculacion         DateTime?
  motivoEncuesta           String?
  transfA                  String?
  asesorCodigo             String?
  asesorNombre             String?
  codigoCliente            String?
  personaTipo              String?
  digitoVerificacion       String?
  sociedadTipo             String?
  barrio                   String?
  ciudad                   String?
  departamento             String?
  establecimientoNombre    String?
  correoFacturacion        String?
  contactoComercial        String?
  cargoContacto            String?
  correoComercial          String?
  celularContacto          String?
  condicionesPago          String?
  condicionesPagoDias      Int?
  documentosEntregados     String?
  ameritaSeguimiento       Boolean?
  formaPago                String?
  formaPagoContado         String?
  formaPagoContadoCual     String?
  formaContacto            String?
  formaContactoOtra        String?
  transaccionDetalles      String?
  asesorTransaccion        String?
  porcentajeAutorizado     Float?
  observacionesTransaccion String?
  firmaNombre              String?
  firmaCedula              String?
  firmaFecha               DateTime?
  firma                    String?
  descripcion              String?
  adjuntos                 Json?

  // Relaciones inversas
  ventas            Venta[]
  cotizaciones      Cotizacion[]
  pqrs              PQR[]
  servicios         Servicio[]
  visitasCampo      VisitaCampo[]
  seguimientosCampo SeguimientoCampo[]

  @@index([doc])
  @@index([nom])
}

// 4. Inventario (Productos)
model Inventario {
  id               String  @id
  cod              String  @unique
  ref              String
  nom              String
  marca            String
  clasif           String
  subclasif        String
  tech             String
  btu              String
  volt             String
  cant             Int
  pedido           Int
  precio           Float
  precio_publico   Float?
  precio_tecnico   Float?
  precio_mayorista Float?
  precio_costo     Float?
  vendidas         Int     @default(0)
  lockedBy         String?
  datosExt         Json?

  // Relaciones inversas
  ventaItems      VentaItem[]
  cotizacionItems CotizacionItem[]
  pqrs            PQR[]
  servicios       Servicio[]
}

// 5. Ventas / Facturación
model Venta {
  id               String   @id
  fecha            DateTime
  fechaIso         DateTime
  venceGarantiaIso DateTime
  mesesGarantia    Int

  vendedorId String
  vendedor   User   @relation(fields: [vendedorId], references: [id])

  // Relación con Cliente (Normalizado)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Relación a múltiples productos
  items VentaItem[]

  metodoPago         String
  total              Float
  comisionistaId     String?
  comisionista       Comisionista? @relation(fields: [comisionistaId], references: [id])
  comisionistaNombre String?
  comisionistaPct    Float?
  comisionistaValor  Float?
  estadoComision     String?
  fechaComision      DateTime?
  tipo_precio        String?
  lockedBy           String?

  // Datos desnormalizados del vendedor (Mantenidos por ahora para retrocompatibilidad parcial)
  vendedorNombre       String?
  vendedorCargo        String?
  vendedorEmail        String?
  vendedorMovil        String?
  vendedorCodigoAsesor String?
  equipos              Json?
  materiales           Json?

  pqrs         PQR[]
  servicios    Servicio[]
  visitasCampo VisitaCampo[]
}

model VentaItem {
  id             String     @id @default(uuid())
  ventaId        String
  venta          Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Inventario @relation(fields: [productoId], references: [id])
  cant           Int
  precioUnitario Float
  desc           Float
  serialEquipo   String?
}

// 6. PQRS
model PQR {
  id        String   @id
  fecha     DateTime
  limiteIso DateTime

  // Relación con Cliente (Normalizado)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo       String
  detalle    String
  evidencia  String?
  fileUrl    String? // Reemplaza a fileData String @db.Text
  estado     String
  satisfecho String
  lockedBy   String?

  // Campos adicionales para el rediseño
  radicado            String?
  hechos              String?   @db.Text
  solicitudes         String?   @db.Text
  evidencias          Json? // Reemplaza String @db.Text
  aplicaGarantia      Boolean?  @default(false)
  tratamientoGarantia String?
  terminoLegal        String?
  fechaCierre         DateTime?

  inventarioId String?
  inventario   Inventario? @relation(fields: [inventarioId], references: [id])
  ventaId      String?
  venta        Venta?      @relation(fields: [ventaId], references: [id])
  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  trazabilidad Json? // Reemplaza String @db.Text

  usuarioAsignadoId String?
  usuarioAsignado   User?   @relation("PQRUsuario", fields: [usuarioAsignadoId], references: [id])
}

// 7. Servicios Técnicos
model Servicio {
  id String @id

  // Relación con Cliente (Normalizado)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  fechaProg DateTime
  tipo      String
  obs       String
  estado    String
  obsAdmin  String?
  lockedBy  String?

  // Campos de React
  tecnicoId      String?
  tecnico        User?     @relation("ServicioTecnico", fields: [tecnicoId], references: [id])
  equipoDetalle  String?
  obsRecepcion   String?   @db.Text
  obsDiagnostico String?   @db.Text
  obsCotizacion  String?   @db.Text
  obsEjecucion   String?   @db.Text
  obsCalidad     String?   @db.Text
  fechaCreacion  DateTime?
  fechaIso       DateTime?

  // Campos adicionales para el rediseño
  radicado String?

  inventarioId String?
  inventario   Inventario? @relation(fields: [inventarioId], references: [id])
  ventaId      String?
  venta        Venta?      @relation(fields: [ventaId], references: [id])
  cotizacionId String?
  cotizacion   Cotizacion? @relation(fields: [cotizacionId], references: [id])

  etapaActual    String?
  evidencias     Json? // Reemplaza String @db.Text
  trazabilidad   Json? // Reemplaza String @db.Text
  aplicaGarantia Boolean?            @default(false)
  costoServicio  Float?              @default(0)
  visitasCampo   VisitaCampo[]
  ordenCampo     OrdenServicioCampo?
}

// 8. Solicitudes Laborales (Empleados)
model Solicitud {
  id           String   @id
  fecha        DateTime
  asesorId     String
  asesor       User     @relation("SolicitudAsesor", fields: [asesorId], references: [id])
  nombreAsesor String?
  tipo         String
  detalle      String?
  evidencia    String?
  fileUrl      String? // Reemplaza fileData String @db.Text
  estado       String
  lockedBy     String?

  // Campos de React
  comentario    String?   @db.Text
  fechaRadicado DateTime?
}

// 9. Procesos Disciplinarios
model ProcesoDisciplinario {
  id    String   @id
  fecha DateTime

  asesorId String
  asesor   User    @relation("ProcesoAsesor", fields: [asesorId], references: [id])
  jefeId   String?
  jefe     User?   @relation("ProcesoJefe", fields: [jefeId], references: [id])

  falta            String
  obs              String
  etapa            Int
  descargo         String?
  sancion          String?
  diasSuspension   Int      @default(0)
  renunciaTerminos Boolean  @default(false)
  timestampEtapa   DateTime
  lockedBy         String?
  evidencias       Json?
}

// 10. Evaluaciones de Desempeño
model Evaluacion {
  id    String   @id
  fecha DateTime

  evaluadorId String?
  evaluador   User?   @relation("EvaluacionEvaluador", fields: [evaluadorId], references: [id])
  evaluadoId  String?
  evaluado    User?   @relation("EvaluacionEvaluado", fields: [evaluadoId], references: [id])

  evaluadoNombre String?
  tipo           String?
  obs            String?
  scores         Json? // Guarda el objeto {metas, ppto, atencion, quejas, resp, ventas}
  lockedBy       String?

  // Campos de React
  empleado   String?
  metajobs   Int?
  asistencia Int?
  objetivos  Int?
  promedio   Float?
}

// 11. Comunicados Oficiales
model Anuncio {
  id       String    @id
  fecha    DateTime?
  titulo   String
  mensaje  String?
  lockedBy String?

  // Campos de React
  contenido String?   @db.Text
  expiresAt DateTime?
  expired   Boolean?  @default(false)
}

// 12. Cotizaciones
model Cotizacion {
  id            String   @id
  numCotizacion String?
  fecha         DateTime

  vendedorId String
  vendedor   User   @relation("CotizacionVendedor", fields: [vendedorId], references: [id])

  // Relación con Cliente (Normalizado)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // Relación a múltiples productos
  items CotizacionItem[]

  total              Float
  comisionistaId     String?
  comisionistaNombre String?
  comisionistaPct    Float?
  comisionistaValor  Float?
  lockedBy           String?

  // Nuevos campos para soporte de múltiples ítems y propuesta
  contacto          String?
  condiciones       String?
  tiempoEntrega     String?
  direccionEntrega  String?
  detallePagoMixto  String?
  cuentas           String?
  firmanteNombre    String?
  firmanteCargo     String?
  firmanteCorreo    String?
  firmanteMovil     String?
  garantia          String?
  observacion       String?
  vigencia          Int?      @default(10)
  ivaTipo           String?   @default("exento")
  equipos           Json? // JSON en vez de String
  materiales        Json? // JSON en vez de String
  tipo_precio       String?
  fechaSeguimiento  DateTime?
  estadoSeguimiento String?
  motivoSeguimiento String?
  motivoNoCompra    String?

  // Nuevos campos para datos del vendedor
  vendedorNombre       String?
  vendedorCargo        String?
  vendedorEmail        String?
  vendedorMovil        String?
  vendedorCodigoAsesor String?

  pqrs         PQR[]
  servicios    Servicio[]
  visitasCampo VisitaCampo[]
}

model CotizacionItem {
  id             String     @id @default(uuid())
  cotizacionId   String
  cotizacion     Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  productoId     String
  producto       Inventario @relation(fields: [productoId], references: [id])
  cant           Int
  precioUnitario Float
  desc           Float
}

// 13. Chat Interno
model Chat {
  id        String   @id
  timestamp DateTime @default(now())
  fecha     DateTime

  senderId String
  sender   User   @relation("ChatSender", fields: [senderId], references: [id])
  nombre   String

  receiverId String?
  receiver   User?   @relation("ChatReceiver", fields: [receiverId], references: [id])

  text        String?
  senderTabId String?
  isNudge     Boolean @default(false)

  isSticker  Boolean @default(false)
  stickerId  String?
  stickerUrl String? // Reemplaza stickerData String @db.Text

  isAudio  Boolean @default(false)
  audioUrl String? // Reemplaza audioData String @db.Text

  isFile   Boolean @default(false)
  fileUrl  String? // Reemplaza fileData String @db.Text
  fileName String?
  fileType String?
  fileSize Int?

  isMeeting Boolean   @default(false)
  meetingId String?
  readAt    DateTime?
  isDeleted Boolean   @default(false)
  isEdited  Boolean   @default(false)

  reactions  Json?
  replyTo    String?
  replyToObj Json?
  hiddenBy   Json?
}

// 13.5 Grupos de Chat
model ChatGroup {
  id          String  @id
  nombre      String
  descripcion String?

  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  fecha       DateTime
  integrantes Json // JSON array of user IDs/usernames
}

// 14. Auditoría Interna
model Auditoria {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fecha         DateTime
  action        String
  modulo        String
  recordDetails String?
  shadowingData Json? // Mejorado de String @db.Text a Json
  hash          String?
}

// 15. Notificaciones
model Notificacion {
  id           String   @id
  paraId       String
  para         User     @relation(fields: [paraId], references: [id])
  titulo       String?
  mensaje      String
  de           String?
  tipo         String?
  fecha        DateTime
  leida        Boolean  @default(false)
  targetModule String?
}

// 16. Comisionistas y Técnicos
model Comisionista {
  id             String    @id
  tipo           String?
  nombre         String
  cedula         String?
  telefono       String?
  correo         String?
  direccion      String?
  cliente_remite String?
  valor_venta    Float?
  pct_comision   Float?
  fecha          DateTime?

  ownerId  String?
  owner    User?   @relation(fields: [ownerId], references: [id])
  lockedBy String?

  // Campos de React
  doc          String?
  tel          String?
  porcentaje   Float?
  estado       String?   @default("Activo") // "Activo" | "Inactivo"
  banco        String?
  tipoCuenta   String?
  numeroCuenta String?

  ventas Venta[]
}

// 17. WhatsApp Configuración (Objeto único)
model WhatsappConfig {
  id        Int     @id @default(1)
  phone     String  @default("573000000000")
  status    String  @default("Activo")
  templates String?
}

// 18. Restablecimientos de contraseña pendientes
model PendingReset {
  id     String   @id @default(uuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  token  String
  expire DateTime
}

// 19. Configuracion de Informes (Valores editables)
model InformesConfig {
  id                Int    @id @default(1)
  margenOperativo   Float  @default(72)
  ingresoProyectos  Float  @default(85)
  gastosInstalacion Float  @default(35)
  anticipos         Float  @default(12450000)
  gastosCajaChica   Float  @default(2180000)
  diasHabilesMes    Int    @default(25)
  mesPresupuesto    String @default("ACTUAL")
  fechaCorte        String @default("HOY")
  diasTranscurridos Int    @default(0)
}

// 20. Cuentas de Cobro
model CuentasCobro {
  id               String    @id
  ciudad           String?
  fecha            DateTime?
  cuenta           String?
  nombre           String?
  cedula           String?
  correo           String?
  concepto         String?
  items            Json? // Reemplazado de String @db.Text
  nequi            String?
  titular          String?
  estado           String?   // "Radicada", "En Revisión", "Aprobada", "Pagada", "Rechazada"
  total            Float?    @default(0)
  tecnicos         Json? // Técnicos participantes asociados a la cuenta de cobro
  fechaRadicacion  DateTime?
  fechaAprobacion  DateTime?
  fechaPago        DateTime?
  aprobadoPor      String?
  notasSeguimiento String?
}

// 21. Capacitaciones en Ventas
model Capacitacion {
  id          String   @id
  tipo        String   @default("En Vivo") // "En Vivo", "Autodidactico"
  tema        String
  descripcion String?  @db.Text
  fecha       DateTime
  hora        String
  obligatoria Boolean  @default(true)

  creadorId String
  creador   User   @relation("CapacitacionCreador", fields: [creadorId], references: [id])

  videoLink     String?
  videoFile     String?
  videoFileName String?
  plataforma    String?
  enlaceReunion String?
  tutorFirma    String?
  tutor         String?
  creadoEn      DateTime?
  materiales    Json? // JSON para adjuntos
  asistentes    Json? // JSON: [{ userId, nombre, cargo, asistio: bool, calificacion: float, feedback: text }]
  evaluacion    Json? // JSON: { title: string, questions: [{ text, options: [{text, isCorrect}] }] }
  estado        String  @default("Programada") // Programada, En Curso, Finalizada
  lockedBy      String?
}

// =========================================================================
// MÓDULO: OPERACIONES EXTERNAS Y GESTIÓN COMERCIAL DE CAMPO
// =========================================================================

// 22. Jornadas Laborales de Campo
model JornadaLaboral {
  id                 String    @id @default(uuid())
  usuarioId          String
  usuario            User      @relation(fields: [usuarioId], references: [id])
  fecha              DateTime  @default(now())
  
  // Apertura
  horaInicio         DateTime  @default(now())
  latInicio          Float
  lngInicio          Float
  direccionInicio    String?
  fotoInicio         String?
  odometroInicio     Float?
  bateriaInicio      Int?
  
  // Cierre
  horaFin            DateTime?
  latFin             Float?
  lngFin             Float?
  direccionFin       String?
  fotoFin            String?
  odometroFin        Float?
  bateriaFin         Int?
  dispositivo        String?
  totalVisitas       Int       @default(0)
  totalActividades   Int       @default(0)

  // Trazabilidad Horaria y Asistencia
  horaAlmuerzoInicio     DateTime?
  horaAlmuerzoFin        DateTime?
  retrasoMin             Int       @default(0)
  cumplimientoHorarioPct Float     @default(100)
  
  // Métricas Consolidadas
  estado             String    @default("Iniciada") // "Iniciada" | "En Pausa" | "Finalizada" | "Cierre Automatico"
  tiempoTotalMin     Int       @default(0)
  tiempoEfectivoMin  Int       @default(0)
  tiempoDetenidoMin  Int       @default(0)
  tiempoTransitoMin  Int       @default(0)
  distanciaKm        Float     @default(0)
  
  observaciones      String?   @db.Text
  
  // Relaciones
  pausas             PausaJornada[]
  ubicaciones        RastreoUbicacion[]
  visitas            VisitaCampo[]
  actividades        ActividadCampo[]
  evidencias         EvidenciaCampo[]
  ordenesServicio    OrdenServicioCampo[]

  @@index([usuarioId, fecha])
  @@index([estado])
}

// 23. Pausas y Descansos de la Jornada
model PausaJornada {
  id           String         @id @default(uuid())
  jornadaId    String
  jornada      JornadaLaboral @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  tipo         String         // "Almuerzo" | "Descanso" | "Capacitacion" | "Incidente"
  horaInicio   DateTime       @default(now())
  horaFin      DateTime?
  duracionMin  Int            @default(0)
  lat          Float?
  lng          Float?
  motivo       String?
}

// 24. Telemetría GPS Continua (Breadcrumbs)
model RastreoUbicacion {
  id              String          @id @default(uuid())
  usuarioId       String
  jornadaId       String?
  jornada         JornadaLaboral? @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  lat             Float
  lng             Float
  precision       Float?          // en metros
  velocidad       Float?          // en km/h
  rumbo           Float?          // grados (heading)
  bateria         Int?            // porcentaje (0-100)
  esSimulado      Boolean         @default(false) // Anti Fake GPS
  enMovimiento    Boolean         @default(false)
  redTipo         String?         // "WiFi" | "4G" | "Offline-Cached"
  timestamp       DateTime        @default(now())
  sincronizadoEn  DateTime        @default(now())

  @@index([usuarioId, timestamp])
  @@index([jornadaId, timestamp])
}

// 25. Zonas Comerciales y Territorios
model ZonaComercial {
  id           String           @id @default(uuid())
  codigo       String           @unique
  nombre       String
  ciudad       String?
  departamento String?
  descripcion  String?
  colorHex     String?          @default("#002060")
  metaMensual  Float            @default(0)
  activo       Boolean          @default(true)
  
  asignaciones AsignacionZona[]
  geocercas    Geocerca[]
}

model AsignacionZona {
  id          String        @id @default(uuid())
  zonaId      String
  zona        ZonaComercial @relation(fields: [zonaId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     User          @relation(fields: [usuarioId], references: [id])
  fechaAsig   DateTime      @default(now())
  activo      Boolean       @default(true)
  esLider     Boolean       @default(false)

  @@unique([zonaId, usuarioId])
}

// 26. Geocercas Operativas
model Geocerca {
  id           String         @id @default(uuid())
  nombre       String
  tipo         String         @default("Circular") // "Circular" | "Poligonal"
  centroLat    Float?
  centroLng    Float?
  radioMetros  Float?
  poligonoJson Json?          // Arreglo de coordenadas [[lat, lng], ...]
  zonaId       String?
  zona         ZonaComercial? @relation(fields: [zonaId], references: [id])
  color        String?        @default("#34D399")
  activo       Boolean        @default(true)
}

// 27. Prospectos de Campo
model ProspectoCampo {
  id               String        @id @default(uuid())
  codigo           String        @unique
  nombreComercial  String
  razonSocial      String?
  nitRut           String?
  contactoNombre   String
  contactoTelefono String
  contactoCorreo   String?
  direccion        String
  barrio           String?
  ciudad           String
  lat              Float
  lng              Float
  etapa            String        @default("Prospecto") // "Prospecto" | "Contacto" | "Visita" | "Oportunidad" | "Cotizacion" | "Negociacion" | "Cerrado Ganado" | "Cerrado Perdido"
  origen           String        @default("En Frio / Puerta a Puerta")
  interesDetalle   String?       @db.Text
  presupuestoEst   Float?        @default(0)
  probabilidadPct  Int?          @default(20)
  fechaCierreEst   DateTime?
  motivoPerdida    String?
  creadoPorId      String
  creadoPor        User          @relation("ProspectoVendedor", fields: [creadoPorId], references: [id])
  clienteId        String?       // Si se convierte en cliente del ERP
  fechaCreacion    DateTime      @default(now())
  
  visitas          VisitaCampo[]
  seguimientos     SeguimientoCampo[]

  @@index([creadoPorId])
  @@index([etapa])
}

// 28. Visitas de Campo (Comerciales, Técnicas, Auditorías)
model VisitaCampo {
  id                 String          @id @default(uuid())
  codigo             String          @unique
  jornadaId          String?
  jornada            JornadaLaboral? @relation(fields: [jornadaId], references: [id])
  usuarioId          String
  usuario            User            @relation(fields: [usuarioId], references: [id])
  
  // Destinatario (Cliente existente o Prospecto nuevo)
  clienteId          String?
  cliente            Cliente?              @relation(fields: [clienteId], references: [id])
  prospectoId        String?
  prospecto          ProspectoCampo?       @relation(fields: [prospectoId], references: [id])
  clienteExternoId   String?
  clienteExterno     ClienteExternoCampo?  @relation(fields: [clienteExternoId], references: [id])
  
  tipoVisita         String          @default("Comercial Prospeccion") // "Comercial Prospeccion" | "Comercial Seguimiento" | "Comercial Cierre" | "Cobranza" | "Servicio Tecnico" | "Auditoria"
  estado             String          @default("Programada") // "Programada" | "En Curso" | "Realizada" | "No Efectiva" | "Cancelada"
  
  fechaProgramada    DateTime
  horaEstimada       String?
  
  // Check-In Geoverificado
  checkInHora        DateTime?
  checkInLat         Float?
  checkInLng         Float?
  checkInPrecision   Float?
  checkInDistanciaM  Float?          // Distancia en metros respecto a ubicación del cliente
  checkInFoto        String?
  
  // Check-Out
  checkOutHora       DateTime?
  checkOutLat        Float?
  checkOutLng        Float?
  duracionMin        Int             @default(0)
  
  // Resultados y Compromisos
  motivoNoEfectiva       String?
  contactoAtendio        String?
  resultadoResumen       String?         @db.Text
  resultadoVisita        String?
  observaciones          String?         @db.Text
  actividadesRealizadas  String?         @db.Text
  hallazgos              String?         @db.Text
  compromisosAdquiridos  String?         @db.Text
  situacionesObservadas  String?         @db.Text
  recomendaciones        String?         @db.Text
  compromisos            String?         @db.Text
  proximaVisita          DateTime?
  firmaCliente           String?         // URL o datauri de firma digital
  
  // Documentos ERP Asociados
  cotizacionId           String?
  cotizacion             Cotizacion?     @relation(fields: [cotizacionId], references: [id])
  ventaId                String?
  venta                  Venta?          @relation(fields: [ventaId], references: [id])
  servicioId             String?
  servicio               Servicio?       @relation(fields: [servicioId], references: [id])

  evidencias             Json?           // URLs de fotografías tomadas en sitio
  evidenciasRelacionadas EvidenciaCampo[]
  seguimientos           SeguimientoCampo[]
  actividades            ActividadCampo[]

  createdAt              DateTime        @default(now())

  @@index([usuarioId, fechaProgramada])
  @@index([estado])
}

// 29. Extensión de Órdenes Técnicas de Campo
model OrdenServicioCampo {
  id                 String          @id @default(uuid())
  servicioId         String          @unique
  servicio           Servicio        @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  tecnicoId          String
  tecnico            User            @relation(fields: [tecnicoId], references: [id])
  jornadaId          String?
  jornada            JornadaLaboral? @relation(fields: [jornadaId], references: [id])
  
  checkInHora        DateTime?
  checkInLat         Float?
  checkInLng         Float?
  checkOutHora       DateTime?
  checkOutLat        Float?
  checkOutLng        Float?
  duracionMin        Int             @default(0)
  
  evidenciasAntes    Json?           // Fotos pre-intervención
  evidenciasDespues  Json?           // Fotos post-intervención
  materialesUsados   Json?           // [{ materialId, nombre, cant, serial }]
  
  firmaCliente       String?
  nombreReceptor     String?
  cedulaReceptor     String?
  calificacion       Int?            // 1 a 5 estrellas
  observaciones      String?         @db.Text
}

// 30. Metas Comerciales de Campo
model MetaComercialCampo {
  id             String   @id @default(uuid())
  usuarioId      String
  usuario        User     @relation(fields: [usuarioId], references: [id])
  periodo        String   // "YYYY-MM"
  
  metaVentas     Float    @default(0)
  metaVisitas    Int      @default(0)
  metaProspectos Int      @default(0)
  metaCotiz      Int      @default(0)
  
  ejecVentas     Float    @default(0)
  ejecVisitas    Int      @default(0)
  ejecProspectos Int      @default(0)
  ejecCotiz      Int      @default(0)
  
  cumplimiento   Float    @default(0) // porcentaje consolidado

  @@unique([usuarioId, periodo])
}

// 31. Actividades del Día en Campo
model ActividadCampo {
  id                String          @id @default(uuid())
  codigo            String          @unique
  usuarioId         String
  usuario           User            @relation("ActividadUsuario", fields: [usuarioId], references: [id])
  asignadoPorId     String?
  asignadoPor       User?           @relation("ActividadAsignadaPor", fields: [asignadoPorId], references: [id])
  jornadaId         String?
  jornada           JornadaLaboral? @relation(fields: [jornadaId], references: [id])
  visitaId          String?
  visita            VisitaCampo?    @relation(fields: [visitaId], references: [id])
  
  titulo            String
  descripcion       String?         @db.Text
  prioridad         String          @default("Normal") // "Alta" | "Media" | "Normal" | "Urgente"
  fechaProgramada   DateTime
  horaEstimada      String?
  estado            String          @default("Pendiente") // "Pendiente" | "En ejecucion" | "Finalizada" | "Reprogramada"
  fechaFinalizacion DateTime?
  
  comentarios       Json?           // [{ fecha, usuario, texto }]
  evidencias        Json?           // [{ url, tipo, fecha, lat, lng }]
  evidenciasCampo   EvidenciaCampo[]
  createdAt         DateTime        @default(now())

  @@index([usuarioId, fechaProgramada])
  @@index([estado])
}

// 32. Evidencias Multimedia de Campo
model EvidenciaCampo {
  id            String          @id @default(uuid())
  usuarioId     String
  usuario       User            @relation("EvidenciaUsuario", fields: [usuarioId], references: [id])
  jornadaId     String?
  jornada       JornadaLaboral? @relation(fields: [jornadaId], references: [id])
  visitaId      String?
  visita        VisitaCampo?    @relation(fields: [visitaId], references: [id])
  actividadId   String?
  actividad     ActividadCampo? @relation(fields: [actividadId], references: [id])
  
  tipo          String          // "Fotografia" | "Video" | "Documento" | "PDF" | "Audio"
  url           String
  nombreArchivo String
  tamanoBytes   Int?
  lat           Float?
  lng           Float?
  direccion     String?
  fechaHora     DateTime        @default(now())
  observaciones String?         @db.Text

  @@index([usuarioId, fechaHora])
  @@index([visitaId])
  @@index([actividadId])
}

// 33. Historial y Seguimiento Continuo de Clientes en Campo
model SeguimientoCampo {
  id               String               @id @default(uuid())
  visitaId         String?
  visita           VisitaCampo?         @relation(fields: [visitaId], references: [id])
  clienteId        String?
  cliente          Cliente?             @relation(fields: [clienteId], references: [id])
  prospectoId      String?
  prospecto        ProspectoCampo?      @relation(fields: [prospectoId], references: [id])
  clienteExternoId String?
  clienteExterno   ClienteExternoCampo? @relation(fields: [clienteExternoId], references: [id])
  usuarioId        String
  usuario          User                 @relation("SeguimientoUsuario", fields: [usuarioId], references: [id])
  
  tipoAccion       String?              @default("Seguimiento") // "Llamada" | "Reunion" | "Visita" | "Cotizacion" | "Negociacion" | "Venta" | "Compromiso" | "Observacion"
  fechaHora        DateTime             @default(now())
  resultado        String
  observaciones    String               @db.Text
  compromisos      String?              @db.Text
  proximaActividad String?
  fechaProgramada  DateTime?
  evidencias       Json?

  @@index([clienteId, fechaHora])
  @@index([clienteExternoId, fechaHora])
  @@index([usuarioId, fechaHora])
}

// 34. Evaluaciones de Desempeño Comercial en Campo
model EvaluacionComercialCampo {
  id                    String    @id @default(uuid())
  evaluadorId           String
  evaluador             User      @relation("EvaluacionesCampoEvaluador", fields: [evaluadorId], references: [id])
  usuarioId             String
  usuario               User      @relation("EvaluacionesCampoEvaluado", fields: [usuarioId], references: [id])
  periodo               String    // Formato "YYYY-MM"
  fecha                 DateTime  @default(now())
  grupoCargo            String    // "Dirección Comercial" | "Coordinador Comercial Externo" | "Asesor Comercial Externo"
  calificacionGeneral   Float     // 0 a 100
  estadoCumplimiento    String    // "No Cumple" | "Cumple Parcialmente" | "Cumple" | "Supera lo Esperado"
  
  // Detalle estructurado de indicadores (Grupo A 24 items, Grupo B/C 20 items)
  indicadoresDetalle    Json
  
  // Síntesis Cualitativa y Observaciones del Delegado
  observacionesGenerales String?   @db.Text
  fortalezasGenerales    String?   @db.Text
  debilidadesGenerales   String?   @db.Text
  recomendaciones        String?   @db.Text
  compromisos            String?   @db.Text
  accionesCorrectivas    String?   @db.Text
  oportunidadesMejora    String?   @db.Text
  planAccionGeneral      String?   @db.Text
  fechaSeguimiento       DateTime?
  fechaProximaEvaluacion DateTime?
  aprobadoDelegado       Boolean   @default(true)
  metadata               Json?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([usuarioId, periodo])
  @@index([evaluadorId])
}

// 35. Novedades, Observaciones y Seguimiento del Delegado de Gerencia
model NovedadDelegadoCampo {
  id               String    @id @default(uuid())
  delegadoId       String
  delegado         User      @relation("NovedadDelegadoCreador", fields: [delegadoId], references: [id])
  usuarioId        String
  usuario          User      @relation("NovedadDelegadoComercial", fields: [usuarioId], references: [id])
  tipo             String    // "Observacion" | "Compromiso" | "Incumplimiento" | "Reconocimiento" | "LlamadoAtencion" | "Comentario" | "SolicitudSeguimiento" | "Objetivo"
  titulo           String
  descripcion      String    @db.Text
  gravedad         String?   @default("Normal") // "Baja" | "Normal" | "Alta" | "Critica" | "Felicitacion"
  fecha            DateTime  @default(now())
  fechaCompromiso  DateTime?
  estado           String    @default("Activo") // "Activo" | "Resuelto" | "En_Seguimiento"
  accionCorrectiva String?   @db.Text
  metadata         Json?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([usuarioId, fecha])
  @@index([tipo])
}

// 36. Clientes Externos y Cartera de Campo
model ClienteExternoCampo {
  id                 String    @id @default(uuid())
  codigo             String    @unique
  nombre             String    // Nombre comercial o Razón Social
  nitDoc             String?   // NIT o Cédula
  contacto           String?   // Nombre de la persona de contacto
  telefono           String
  correo             String?
  ciudad             String    @default("Barranquilla")
  direccion          String?
  sectorEconomico    String?   // "Comercio" | "Industria" | "Salud" | "Alimentos" | "Construccion" | "Servicios" | "Otro"
  origen             String    @default("En Frio / Puerta a Puerta")
  tipoRegistro       String    @default("Cliente Potencial") // "Prospecto" | "Cliente Potencial" | "Cliente Activo" | "Cliente Inactivo"
  etapaEmbudo        String    @default("Prospecto") // "Prospecto" | "Cliente Potencial" | "Visita" | "Seguimiento" | "Cotizacion" | "Negociacion" | "Venta" | "Fidelizacion"
  comercialId        String
  comercial          User      @relation("ClienteExternoComercial", fields: [comercialId], references: [id])
  notas              String?   @db.Text
  lat                Float?
  lng                Float?
  
  visitas            VisitaCampo[]
  seguimientos       SeguimientoCampo[]
  cotizaciones       CotizacionExternaCampo[]
  ventas             VentaExternaCampo[]
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([comercialId])
  @@index([etapaEmbudo])
  @@index([tipoRegistro])
}

// 37. Cotizaciones Comerciales Externas de Campo
model CotizacionExternaCampo {
  id                 String              @id @default(uuid())
  codigo             String              @unique
  clienteExternoId   String
  clienteExterno     ClienteExternoCampo @relation(fields: [clienteExternoId], references: [id])
  comercialId        String
  comercial          User                @relation("CotizacionExternaComercial", fields: [comercialId], references: [id])
  fecha              DateTime            @default(now())
  validezDias        Int                 @default(15)
  estado             String              @default("Borrador") // "Borrador" | "Enviada" | "En Negociacion" | "Aprobada" | "Rechazada"
  total              Float               @default(0)
  items              Json                // [{ descripcion, cantidad, precioUnit, subtotal }]
  observaciones      String?             @db.Text
  seguimientos       Json?               // [{ fecha, usuario, accion, nota }]
  historial          Json?               // [{ fecha, estadoAnterior, nuevoEstado, nota }]
  
  ventas             VentaExternaCampo[]
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([comercialId])
  @@index([clienteExternoId])
  @@index([estado])
}

// 38. Ventas y Cierres Comerciales Externos de Campo
model VentaExternaCampo {
  id                 String                  @id @default(uuid())
  codigo             String                  @unique
  clienteExternoId   String
  clienteExterno     ClienteExternoCampo     @relation(fields: [clienteExternoId], references: [id])
  comercialId        String
  comercial          User                    @relation("VentaExternaComercial", fields: [comercialId], references: [id])
  cotizacionId       String?
  cotizacion         CotizacionExternaCampo? @relation(fields: [cotizacionId], references: [id])
  fecha              DateTime                @default(now())
  valorVendido       Float                   @default(0)
  metodoPago         String?                 @default("Contado") // "Contado" | "Credito 15d" | "Credito 30d" | "Transferencia"
  observaciones      String?                 @db.Text
  items              Json?                   // [{ descripcion, cantidad, precioUnit, subtotal }]
  estado             String                  @default("Cerrada") // "Cerrada" | "Entregada" | "Cancelada"
  
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([comercialId])
  @@index([clienteExternoId])
}




